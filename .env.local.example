# 复制本文件为 .env.local 后填写。.env.local 不会被提交到 git。

# Steam Web API Key：https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# 你的 SteamID64（17 位数字），可在 https://steamid.io 查询
STEAM_ID=

# 可选：数据目录。默认 Windows 为 %LOCALAPPDATA%\GameGallery，其他系统为项目下的 data/
# DATA_DIR=

# 可选：如果访问 Steam / Epic 需要代理（例如 Clash），填写本地代理地址
# HTTPS_PROXY=http://127.0.0.1:7897

# 关闭 Next.js 匿名遥测
NEXT_TELEMETRY_DISABLED=1
